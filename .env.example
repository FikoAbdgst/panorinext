# ---- Supabase ----
# Ambil dari Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Khusus server. JANGAN pernah diekspos ke client / prefix NEXT_PUBLIC_.
# Dipakai untuk operasi admin: signed URL bukti bayar, upload aset, dsb.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Aplikasi ----
# Base URL publik (dipakai untuk link unduhan sementara di email).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="PanoriCam <no-reply@panoricamofficial.com>"
